# Copy to .env (used by `docker compose`) and fill in.
DISCORD_TOKEN=your_discord_bot_token_here
# The voice channel the radio lives in
VOICE_CHANNEL_ID=your_voice_channel_id_here

# Optional
# PORT=8080      # health-check port (default 8080)
# PAUSED=1       # run only the health server and don't connect to Discord (stands this copy down)
