# Copy this file to .env and fill in your values
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: restrict bot to specific guild (server) ID for faster slash command registration
# GUILD_ID=your_guild_id_here

# Optional: 24/7 radio mode — bot auto-joins a voice channel and plays a stream forever
# RADIO_URL=https://tunein.com/radio/s30358/   (or any direct stream URL)
# RADIO_CHANNEL_ID=your_voice_channel_id_here

# Optional: Discord premium. Create a server subscription under Developer Portal > Monetization,
# then paste its SKU ID. Leave unset to keep everything free (no gating).
# PREMIUM_SKU_ID=your_sku_id_here
# PREMIUM_RESERVED_STREAMS=2   # extra simultaneous radio servers only premium servers can use
# FREE_SESSION_HOURS=4   # how long a free server's radio runs before it stops (0 = no limit); premium is always 24/7

# Optional: top.gg vote perks. In top.gg > your bot > Webhooks, set the URL to https://<your-fly-app>.fly.dev/topgg
# and paste the secret here (a `whs_...` secret uses signed webhooks; any other value is the legacy Authorization secret).
# TOPGG_WEBHOOK_SECRET=whs_...
