# Copy to .env and fill in. (The bot reads this file itself, so you don't have to set variables in your shell.)
DISCORD_TOKEN=your_discord_bot_token_here
# The voice channel the radio lives in (VOICE_CHANNEL_ID works too)
RADIO_CHANNEL_ID=your_voice_channel_id_here

# Optional
# GUILD_ID=your_server_id               # the /play music commands only work on this server
# NOW_PLAYING_CHANNEL_ID=text_channel_id  # where the live card goes (default: the voice channel's own chat)
# JOIN_MUTE=0                           # 0 = don't mute the radio while a joiner decides on the prompt
# BRANDING=1                            # 1 = rename the bot to Crue FM and set its icon and banner
# RADIO_URL=https://...                 # use a different Q101 stream
